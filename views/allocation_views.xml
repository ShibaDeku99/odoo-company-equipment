<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_company_equipment_allocation_tree" model="ir.ui.view">
        <field name="name">company.equipment.allocation.tree</field>
        <field name="model">company.equipment.allocation</field>
        <field name="arch" type="xml">
            <list string="Phiếu cấp phát">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="equipment_id"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-warning="state == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_company_equipment_allocation_form" model="ir.ui.view">
        <field name="name">company.equipment.allocation.form</field>
        <field name="model">company.equipment.allocation</field>
        <field name="arch" type="xml">
            <form string="Phiếu cấp phát">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="equipment_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú" name="note">
                            <field name="note" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_company_equipment_allocation" model="ir.actions.act_window">
        <field name="name">Cấp phát thiết bị</field>
        <field name="res_model">company.equipment.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu cấp phát mới
            </p>
        </field>
    </record>

</odoo>
