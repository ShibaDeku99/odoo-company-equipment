<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_company_equipment_tree" model="ir.ui.view">
        <field name="name">company.equipment.tree</field>
        <field name="model">company.equipment</field>
        <field name="arch" type="xml">
            <list string="Thiết bị">
                <field name="currency_id" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="serial_number"/>
                <field name="purchase_date"/>
                <field name="purchase_price" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'assigned'" decoration-warning="state == 'maintenance'" decoration-danger="state in ['broken', 'lost']"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_company_equipment_form" model="ir.ui.view">
        <field name="name">company.equipment.form</field>
        <field name="model">company.equipment</field>
        <field name="arch" type="xml">
            <form string="Thiết bị">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,assigned,maintenance,broken,liquidated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Laptop Dell XPS 15"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="allocation_date"/>
                            <field name="purchase_date" groups="equipment_management.group_equipment_user"/>
                            <field name="currency_id" groups="equipment_management.group_equipment_user"/>
                            <field name="purchase_price" groups="equipment_management.group_equipment_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin khấu hao" name="depreciation" groups="equipment_management.group_equipment_user">
                            <group>
                                <group>
                                    <field name="depreciation_start_date"/>
                                    <field name="useful_life_years"/>
                                    <field name="salvage_value"/>
                                </group>
                                <group>
                                    <field name="annual_depreciation"/>
                                    <field name="depreciation_rate"/>
                                    <field name="accumulated_depreciation"/>
                                    <field name="remaining_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="Lịch sử bảo trì" name="maintenance" groups="equipment_management.group_equipment_user">
                            <field name="maintenance_ids" readonly="1">
                                <list>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="vendor_id"/>
                                    <field name="cost" sum="Tổng chi phí"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Thông tin thanh lý" name="liquidation" groups="equipment_management.group_equipment_user">
                            <field name="liquidation_ids" readonly="1">
                                <list>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="reason"/>
                                    <field name="price"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_company_equipment_search" model="ir.ui.view">
        <field name="name">company.equipment.search</field>
        <field name="model">company.equipment</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm thiết bị">
                <field name="name"/>
                <field name="code"/>
                <field name="serial_number"/>
                <field name="category"/>
                <filter string="Trong kho" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Đang sử dụng" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <group name="group_by">
                    <filter string="Người sử dụng" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Loại thiết bị" name="group_by_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_company_equipment" model="ir.actions.act_window">
        <field name="name">Thiết bị công ty</field>
        <field name="res_model">company.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo thiết bị mới
            </p>
        </field>
    </record>

</odoo>
